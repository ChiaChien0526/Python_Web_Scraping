   "source": [
    "# 清空放置列表資訊的變數\n",
    "list_posts2.clear()\n",
    "\n",
    "headers = {\n",
    "    \"User-Agent\": \"Mozilla/5.0\"\n",
    "}\n",
    "\n",
    "# 取得中文書網頁中的內文連結\n",
    "for index, obj in enumerate(list_posts):\n",
    "    res_ = req.get(obj['link'],  headers=headers)\n",
    "    soup_ = bs(res_.text, \"html.parser\")\n",
    "\n",
    "    for a in soup_.select('td.unpadded.icon_save > a[type=\"text/plain; charset=us-ascii\"]'):\n",
    "        # Plain Text UTF-8 的標題&連結\n",
    "        title_tag = soup_.select_one('h1#book_title')\n",
    "        book_title = title_tag.get_text(strip=True) if title_tag else f\"book_{index}\"\n",
    "        match = re.search(r'[\\u4e00-\\u9fff]{2,}', book_title)\n",
    "        book_title_clean = match.group(0) if match else book_title\n",
    "        print(a['href'])\n",
    "\n",
    "        # 加入列表資訊\n",
    "        list_posts2.append({\n",
    "            'title': book_title_clean,\n",
    "            'link': 'https://www.gutenberg.org' + a['href'] \n",
    "        })"
   ]
