   "cell_type": "code",
   "execution_count": 9,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 使用 requests 工具\n",
    "import requests as req\n",
    "from bs4 import BeautifulSoup as bs\n",
    "\n",
    "# 匯入 regex 、 os套件\n",
    "import re\n",
    "import os"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Project Gutenberg 中文書網址\n",
    "url = \"https://www.gutenberg.org/browse/languages/zh\"\n",
    "\n",
    "headers = {\n",
    "    \"User-Agent\": \"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36\"\n",
    "}\n",
    "\n",
    "# 用 requests 的 get 方法把網頁抓下來\n",
    "res = req.get(url, headers=headers, timeout=10)\n",
    "\n",
    "# 指定 lxml 作為解析器\n",
    "soup = bs(res.text, \"html.parser\") \n",
    "\n",
    "# 建立 list 來放置列表資訊\n",
    "list_posts = []\n",
    "list_posts2 = []"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "metadata": {},
   
    }
   ],
   "source": [
    "# 清空放置列表資訊的變數\n",
    "list_posts.clear()\n",
    "\n",
    "# 取得中文書的文字與超連結\n",
    "for a in soup.select('li.pgdbetext > a[href]'):\n",
    "    text = a.get_text()\n",
    "    if re.search(r'[\\u4E00-\\u9FFF]', text):\n",
    "        print(text)\n",
    "        print(a['href'])\n",
    "\n",
    "        # 加入列表資訊\n",
    "        list_posts.append({\n",
    "            'title': text,\n",
    "            'link': 'https://www.gutenberg.org' + a['href']\n",
    "        })"
   ]
  },
