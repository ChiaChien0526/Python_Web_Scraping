   "source": [
    "# 首頁網址\n",
    "prefix = 'https://www.gutenberg.org'\n",
    "\n",
    "# 儲存目標資料夾\n",
    "output_folder = \"project_gutenberg\"\n",
    "os.makedirs(output_folder, exist_ok=True)\n",
    "\n",
    "\n",
    "# 保留：中文字元、中文標點（全形）、換行符號\n",
    "def extract_clean_chinese(text):\n",
    "    result = []\n",
    "    for char in text:\n",
    "        if re.match(r'[\\u4e00-\\u9fff]', char):\n",
    "            result.append(char)\n",
    "        elif char in '，。？！；：「」『』、．《》（）—':\n",
    "            result.append(char)\n",
    "        elif char == '\\n':\n",
    "            result.append(char)\n",
    "    return ''.join(result)\n",
    "\n",
    "# 取得中文書中的內容\n",
    "for index, obj in enumerate(list_posts2):\n",
    "    full_url = prefix + obj['link'] if obj['link'].startswith('/') else obj['link']\n",
    "    res_ = req.get(full_url, headers=headers)\n",
    "    res_.encoding = 'utf-8'\n",
    "\n",
    "    content = res_.text\n",
    "\n",
    "    # 保留中文內容\n",
    "    chinese_text = extract_clean_chinese(content)\n",
    "\n",
    "    # 用書名做檔名\n",
    "    title = obj.get('title', f\"book_{index}\")\n",
    "    # 移除非法檔名字元，空白轉底線\n",
    "    clean_title = re.sub(r'[\\\\/:*?\"<>|]', '', title).strip().replace(' ', '_')\n",
    "    file_path = os.path.join(output_folder, f\"{clean_title}.txt\")\n",
    "\n",
    "    \n",
    "    # 儲存為文字檔\n",
    "    with open(file_path, 'w', encoding='utf-8') as f:\n",
    "        f.write(chinese_text + '\\n\\n')\n",
    "\n",
    "    print(f\"已儲存：{file_path}\")"
   ]
  }
